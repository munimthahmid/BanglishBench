# Publication whitelist for the BanglishBench repository.
# Everything is ignored by default. Only source, curated artifacts, and
# reproducibility materials explicitly unignored below are eligible for Git.

/*

# Repository metadata and public docs
!/.gitignore
!/README.md
!/LICENSE
!/DATA_LICENSE.md
!/NOTICE.md

# Technical report source and compiled PDF
!/paper/
/paper/**
!/paper/**/
!/paper/banglishbench-report.tex
!/paper/banglishbench.sty
!/paper/references.bib
!/paper/references.tex
!/paper/abstract.tex
!/paper/acknowledgements.tex
!/paper/usebangla.sty
!/paper/banglishbench-report.pdf
!/paper/chapters/**/*.tex
!/paper/figures/**
!/paper/inputs/**/*.tex
!/paper/parameters/**/*.txt

# Public reports and figures
!/reports/
/reports/**
!/reports/**/
!/reports/**/*.md
!/reports/figures/**

# Curated result tables and analysis outputs.
# Raw model runs and API payloads remain ignored.
!/results/
/results/**
!/results/**/
!/results/tables/**/*.csv
!/results/tables/**/*.md
!/results/analysis/*.csv
!/results/analysis/*.md
!/results/tokenization/**/*.csv

# Public dataset slices and review artifacts used for reproducibility
!/data/
/data/**
!/data/**/
!/data/slices/**/*.jsonl
!/data/slices/**/*.json
!/data/slices/**/*.csv
!/data/slices/**/*.md
!/data/generated_views/**/*.jsonl
!/human_review/
/human_review/**
!/human_review/**/
!/human_review/**/*.jsonl

# Reproduction/analysis scripts
!/scripts/
/scripts/**
!/scripts/**/
!/scripts/**/*.py

# Local bibliography seed only; third-party literature code clones stay ignored
!/literature/
/literature/**
!/literature/**/
!/literature/references_seed.bib

# Always keep private/local/generated material out of Git, even if patterns
# above are relaxed later.
.env
.env.*
.claude/
.codex/
.agents/
.kaggle/
*.pem
secrets/
credentials.*
*_credentials.*
*_credential.*
kaggle*.json
kaggle*.txt
kaggle (*).json
claude_conversation.txt
gpu_config.txt
presentation/
defense_presentation/
sample_presentation/
requirements-kaggle*.txt

# Virtual environments, caches, and build products
.venv*/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# LaTeX/generated build files, except explicitly allowed final PDFs above
*.aux
*.bbl
*.blg
*.idx
*.ilg
*.ind
*.loa
*.lof
*.log
*.lot
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.fls
*.fdb_latexmk

# Large/local experiment outputs
results/runs/
results/api_audit/
results/generated_views/
data/api_audit/
data/raw/
data/processed/
data/pilot*/
kaggle_jobs/
literature/code/

# Internal drafts, planning notes, and local execution runbooks
reports/chapter_*_draft.md
reports/*thesis*.md
reports/continuous_research_checkpoint_*.md
reports/*kaggle*.md
reports/*runbook*.md
reports/*cost_plan*.md
reports/post_v5_compute_budget.md
reports/post_v5_rerun*.md
reports/validation200_v5_next_session_brief.md
reports/validation200_v5_review_resume_card.md
reports/script_matters_paper_draft.md
reports/next_experiment_decision_queue.md
reports/open_model_next_experiment_plan.md
reports/research_log_compactness_check.md
results/analysis/thesis_*.csv
results/analysis/post_v5_compute_budget.csv
results/analysis/post_v5_kaggle_job_plan.csv
results/analysis/validation200_v5_next_session_brief.csv
results/analysis/validation200_v5_review_resume_card.csv
results/analysis/pilot20_*.csv
results/tables/diagnostic_model_pilots.csv
results/tables/thesis_tables.md
scripts/build_pilot.py
scripts/build_post_v5_compute_budget.py
scripts/build_post_v5_kaggle_job_plan.py
scripts/build_thesis_*.py
scripts/build_v5_next_session_brief.py
scripts/check_thesis_*.py
scripts/compile_thesis_draft.py
scripts/export_v5_review_resume_card.py
scripts/kaggle_with_account.py
scripts/prepare_kaggle*.py
scripts/run_eval_kaggle.py
